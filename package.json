{
  "name": "@eliware/resampler",
  "version": "13.0.0",
  "type": "module",
  "description": "A pure JavaScript, high-quality PCM audio resampler for Node.js. Converts s16le PCM between arbitrary sample rates and channel layouts (mono/stereo) with windowed-sinc filtering.",
  "keywords": [
    "resampler",
    "pcm",
    "audio",
    "s16le",
    "sample-rate",
    "windowed-sinc",
    "nodejs",
    "stereo",
    "mono",
    "pure-js",
    "audio-processing",
    "volume-control"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./src/index.mjs",
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "examples/",
    "specs/"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "typecheck": "tsc --project tsconfig.json",
    "pack": "eliware-test --pack",
    "benchmark": "node examples/benchmark.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "@eliware/test": "^13.0.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/resampler.git"
  },
  "homepage": "https://github.com/eliware/resampler#readme",
  "bugs": {
    "url": "https://github.com/eliware/resampler/issues"
  },
  "eliware": {
    "id": "E-240",
    "apply": [
      "general",
      "library",
      "npm-published"
    ]
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  }
}
